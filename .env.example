# Copy this to .env and fill in real values. .env is git-ignored -- it's
# meant to hold your machine's actual configuration, never committed.

# --- Model (required) ---
# Filename of a .gguf file already placed in models/. No default -- the
# stack refuses to start without this set.
MODEL_FILE=Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf

# --- GPU offload ---
# Layers offloaded to GPU. 99 (default) means "as many as exist" -- safe for
# any model, llama.cpp clamps it to the model's actual layer count.
NGL=99

# MoE-only: forces this many expert layers to CPU/RAM instead of GPU. A
# no-op for dense (non-MoE) models -- leave at the default 0 for those.
# For a MoE model that doesn't fit fully in VRAM, raise this until it does.
# Rule of thumb: expert tensors are usually ~90%+ of a MoE model's total
# size, so start from (model file size in GB) / (total expert layers) to
# estimate GB-per-layer, then pick a value that leaves ~1-2GB VRAM headroom
# for your desktop/other apps on top of what the model needs.
N_CPU_MOE=0

# --- Context and threads ---
# KV-cache context window. Larger = more VRAM for the KV-cache (scales with
# this value regardless of prompt length actually used).
CONTEXT_SIZE=8192

# RAM-side prompt cache: stores past prompts' KV state so a similar-prefix
# request can reuse it instead of reprocessing from scratch. llama.cpp
# default is 8192 -- worth lowering if the host is also running other
# memory-hungry things (desktop use, other containers) and llm-server's own
# RAM footprint (from N_CPU_MOE-offloaded expert weights) is already tight.
# 0 disables it (every prompt reprocesses fully); -1 = no limit.
CACHE_RAM_MIB=2048

# CPU threads for the portion of the model NOT on GPU. For a fully-GPU dense
# model this barely matters; for a MoE model with real CPU-offloaded expert
# layers, tune this against your own core count (see README.md "Tuning").
THREADS=4

# Optional: restrict inference to a specific CPU core range (Docker cgroup
# cpuset syntax, e.g. "8-19"). Empty (default) = unrestricted, uses all
# cores. Only worth setting on a hybrid P-core/E-core CPU where you've
# confirmed (see README.md "Tuning") that scoping to specific cores helps
# your specific workload -- it isn't a universal win.
LLM_CPUSET=

# --- Hardware (optional, portal/docs/hardware.html) ---
# PSU and case can't be detected in software -- scripts/detect-hardware.sh
# reads these two directly instead of probing for them. Leave unset and the
# hardware page just shows "Not set" for these two rows. Quote the value if
# it contains spaces -- this file gets sourced by bash, not just parsed as
# key=value.
PSU_MODEL=
CASE_MODEL=

# --- Domain / HTTPS ---
# Your own domain (or "localhost" if you don't want a custom one). Only
# matters if you're using the Caddy/TLS setup -- see
# scripts/generate-local-ca.sh and README.md "Custom domain + HTTPS".
DOMAIN=localhost

# --- Web search ---
# ISO language code (e.g. "no", "en", "de") to bias SearXNG results toward,
# or "all" for no bias. Used by scripts/bootstrap-openwebui.sh. Matters
# because OpenWebUI's own query-generation step can drift into English
# regardless of what language you're chatting in -- see that script's
# fix_search_query_language for the full story (2026-07-27).
SEARXNG_LANGUAGE=all

# --- Monitoring (optional, deployments/compose.monitoring.yml) ---
# Grafana's admin login. Change this before exposing Grafana beyond
# localhost -- see README.md "Monitoring".
GRAFANA_ADMIN_PASSWORD=admin

# --- Admin panel (optional, deployments/compose.admin.yml) ---
# Gates /admin/* via Caddy's basic_auth -- the admin app itself has no
# login of its own. Generate the hash with:
#   docker run --rm caddy:2.9.1-alpine caddy hash-password --plaintext 'your-password-here'
# Paste the bcrypt output below -- never a plaintext password. Double every
# literal $ to $$ (Compose's own .env interpolation treats a lone $ followed
# by a letter as a variable reference and silently blanks it out -- a real
# bcrypt hash like $2a$14$abc... will otherwise get corrupted). See
# README.md "Admin panel" for what this service can do (docker.sock RW).
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# UID the admin container's app user runs as -- must match your host user's
# UID (run `id -u`) or writes through its /repo bind mount (e.g.
# portal/docs/hardware.html) fail with a permission error. Defaults to 1000
# (the typical first host user on Linux) if left unset. Only takes effect on
# `docker compose build` -- rebuild the admin image after changing this.
ADMIN_UID=

# Absolute path to this repo ON THIS HOST (not inside any container), e.g.
# /home/you/local_LLM. Required for the admin panel: it drives `docker
# compose` from inside its own container via the socket-mounted docker.sock,
# which talks to the HOST's daemon -- so any relative volume path in
# compose.yml (./models, ./certs, ...) must resolve against a real host
# path, not the container-internal /repo mount, or the daemon bind-mounts
# an empty directory instead of your actual files.
HOST_REPO_DIR=

# OpenWebUI's own admin login -- used by the admin panel to call OpenWebUI's
# API directly (over local-llm-net, not through Caddy) after a model switch,
# so it can set function_calling=legacy for the new model automatically
# (without this, OpenWebUI's web search silently stops working for the new
# model until scripts/bootstrap-openwebui.sh is run by hand -- see that
# script's own header comment for why). Same account bootstrap-openwebui.sh
# sets up -- reuse the same password you gave that script.
OPENWEBUI_ADMIN_EMAIL=admin@localhost
OPENWEBUI_ADMIN_PASSWORD=
