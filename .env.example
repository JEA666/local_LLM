# Copy this to .env and fill in real values. .env is git-ignored -- it's
# meant to hold your machine's actual configuration, never committed.

# --- Model (required) ---
# Filename of a .gguf file already placed in models/. No default -- the
# stack refuses to start without this set.
MODEL_FILE=Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf

# --- GPU offload ---
# Layers offloaded to GPU. 99 (default) means "as many as exist" -- safe for
# any model, llama.cpp clamps it to the model's actual layer count.
NGL=99

# MoE-only: forces this many expert layers to CPU/RAM instead of GPU. A
# no-op for dense (non-MoE) models -- leave at the default 0 for those.
# For a MoE model that doesn't fit fully in VRAM, raise this until it does.
# Rule of thumb: expert tensors are usually ~90%+ of a MoE model's total
# size, so start from (model file size in GB) / (total expert layers) to
# estimate GB-per-layer, then pick a value that leaves ~1-2GB VRAM headroom
# for your desktop/other apps on top of what the model needs.
N_CPU_MOE=0

# --- Context and threads ---
# KV-cache context window. Larger = more VRAM for the KV-cache (scales with
# this value regardless of prompt length actually used).
CONTEXT_SIZE=8192

# CPU threads for the portion of the model NOT on GPU. For a fully-GPU dense
# model this barely matters; for a MoE model with real CPU-offloaded expert
# layers, tune this against your own core count (see README.md "Tuning").
THREADS=4

# Optional: restrict inference to a specific CPU core range (Docker cgroup
# cpuset syntax, e.g. "8-19"). Empty (default) = unrestricted, uses all
# cores. Only worth setting on a hybrid P-core/E-core CPU where you've
# confirmed (see README.md "Tuning") that scoping to specific cores helps
# your specific workload -- it isn't a universal win.
LLM_CPUSET=

# --- Domain / HTTPS ---
# Your own domain (or "localhost" if you don't want a custom one). Only
# matters if you're using the Caddy/TLS setup -- see
# scripts/generate-local-ca.sh and README.md "Custom domain + HTTPS".
DOMAIN=localhost

# --- Monitoring (optional, deployments/compose.monitoring.yml) ---
# Grafana's admin login. Change this before exposing Grafana beyond
# localhost -- see README.md "Monitoring".
GRAFANA_ADMIN_PASSWORD=admin
