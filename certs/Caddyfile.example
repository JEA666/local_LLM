{
	# Admin API (which serves /metrics) binds to 127.0.0.1 by default --
	# unreachable from other containers (like Prometheus) even on the same
	# docker network.
	admin 0.0.0.0:2019
	auto_https off
	servers {
		metrics
	}
}

DOMAIN_PLACEHOLDER:443 {
	tls /certs/server.crt /certs/server.key

	# SearXNG and Grafana both have their own subpath-aware middleware
	# (SearXNG: searx/flaskfix.py's ReverseProxyPathFix, reads server.base_url;
	# Grafana: root_url + serve_from_sub_path in grafana.ini) -- both expect
	# to receive the FULL path including the prefix and strip it themselves,
	# so this must be `handle`, not `handle_path` (which would strip it here
	# instead and break their internal link generation).
	handle /search/* {
		reverse_proxy searxng:8080
	}

	# Optional: only reachable if deployments/compose.monitoring.yml is up.
	handle /obs/* {
		reverse_proxy grafana:3000
	}

	# llm-server has zero prefix awareness (its own routes are fixed, e.g.
	# /v1/chat/completions) -- Caddy strips the prefix before forwarding.
	handle_path /llm/* {
		reverse_proxy llm-server:8080
	}

	# Optional: only reachable if deployments/compose.admin.yml is up.
	# The admin app's own routes (/, /switch-model, ...) have no prefix
	# awareness either, so strip it here, same as llm-server above.
	# basic_auth is the only access control this service has -- see
	# README.md "Admin panel" for the docker.sock read-write exception this
	# gates. Password hash comes from ADMIN_PASSWORD_HASH in .env, generated
	# via `caddy hash-password`; never a plaintext value in this file.
	handle_path /admin/* {
		basic_auth {
			{$ADMIN_USERNAME:admin} {$ADMIN_PASSWORD_HASH}
		}
		reverse_proxy admin:8080
	}

	# Drone Guide: a Docusaurus static site (drone_workshop/build/), served
	# directly by Caddy rather than proxied through Dashy. Docusaurus emits
	# extensionless links (e.g. /docs/intro for the file docs/intro.html) --
	# Dashy's own static serving has no extension/clean-URL resolution, so
	# in-app client-side navigation would work but a hard refresh or a
	# shared deep link would 404. try_files appends .html here so both work.
	handle_path /drone-guide/* {
		# /srv/drone-guide is the mounted repo root, not the built site --
		# compose.yml mounts the parent dir on purpose (Docusaurus replaces
		# build/ wholesale on each rebuild), so the actual site root is one
		# level down.
		root * /srv/drone-guide/build

		# Known Docusaurus SPA bug (github.com/facebook/docusaurus/issues/10053,
		# #9552, #9916): loading a page via a literal *.html URL (typically
		# .../index.html) instead of the clean directory URL makes React's
		# client-side router fail to recognize the current route, so hydration
		# mounts a second full copy of the page below the original -- visible
		# as the whole page (navbar, hero, footer) repeating, and the topmost,
		# broken copy's buttons (e.g. the dark-mode toggle) staying inert.
		# Redirect any *.html request to its clean URL before it can hit
		# that path, rather than serving the file directly via try_files.
		# Two matchers, most-specific first: .../index.html -> its directory
		# URL (Docusaurus's own convention), any other .../foo.html -> foo
		# with the extension stripped. Caddy preserves the textual order of
		# repeated same-name directives, so the index case is tried first.
		@indexFile path_regexp indexFile ^(.*/)index\.html$
		redir @indexFile /drone-guide{http.regexp.indexFile.1} permanent

		@htmlFile path_regexp htmlFile ^(.*)\.html$
		redir @htmlFile /drone-guide{http.regexp.htmlFile.1} permanent

		try_files {path} {path}.html
		file_server
	}

	# Catch-all: Dashy, the portal. Also serves portal/docs/*.html,
	# portal/drone-workshop/*, and certs/ca.crt as static files from its own
	# public dir (bind-mounted in compose.yml) -- unaffected by the routes
	# above.
	handle {
		reverse_proxy dashy:8080
	}
}

# OpenWebUI can't be path-routed -- its SvelteKit build has absolute
# root-relative asset paths (/static/..., /_app/immutable/...) baked in at
# build time, with no subpath/base-path config available. Stays on its own port.
DOMAIN_PLACEHOLDER:3000 {
	tls /certs/server.crt /certs/server.key
	reverse_proxy openwebui:8080
}
